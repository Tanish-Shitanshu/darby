# ---- LLM provider (pick one; the provider layer is pluggable) ----
LLM_PROVIDER=azure            # azure | openai | replay
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=      # a chat/vision-capable deployment name
OPENAI_API_KEY=               # fallback if LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
# ---- Google (Sheets + Drive) ----
GOOGLE_OAUTH_CLIENT_FILE=secrets/google-oauth.json
GOOGLE_TOKEN_FILE=secrets/google-token.json
SHARE_TEST_EMAIL=             # a teammate's email used as the "team" in the share step
# ---- GitHub (test repo only) ----
GITHUB_TOKEN=
GITHUB_TEST_REPO=             # owner/darby-launch-test
# ---- Fixtures ----
FIXTURE_PORT=4010
DARBY_SOURCES=fixture         # fixture | live
