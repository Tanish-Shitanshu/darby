# Copy to .env and fill in. .env and secrets/ are gitignored; never commit a key.
# ---- LLM provider ----
# sarvam  = Sarvam AI chat model (sarvam-105b) for planning/reading/writing; needs SARVAM_API_KEY; image steps still use Gemini if GEMINI_API_KEY is set
# gemini  = Google AI Studio free key (https://aistudio.google.com/apikey) <- default for development; never enable billing
# replay  = no network: answers only from recorded responses (replay/ + .darby/replay). Used by tests and the offline demo.
# openai | azure = kept working but not used by the project
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash   # verified via the models list endpoint + a live call; supports image input + JSON output
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.8-flash   # tried in order when the primary is overloaded (503/timeout)
GEMINI_RPM=9                    # free-tier requests per minute we allow ourselves (sliding window)
LLM_CONCURRENCY=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# ---- Sheets / Google (M4, optional) ----
SHEET_ADAPTER=local             # local | google
GOOGLE_OAUTH_CLIENT_FILE=secrets/google-oauth.json
GOOGLE_TOKEN_FILE=secrets/google-token.json
SHARE_TEST_EMAIL=               # a teammate's email used as the "team" in the share step
# ---- Sarvam AI (voice chat in Indian languages: speech-to-text, translation, spoken replies) ----
SARVAM_API_KEY=                 # optional; without it Darby still works in English (text, and voice through the Gemini fallback)
# ---- GitHub (M6, test repo only) ----
GITHUB_TOKEN=
GITHUB_TEST_REPO=               # owner/darby-launch-test
DARBY_VOICE=                    # optional: force the voiceover engine (edge-tts | macos-say | espeak-ng); empty = first that works
# ---- Runtime ----
PORT=4000
FIXTURE_PORT=4010
DARBY_SOURCES=fixture           # fixture | live
DARBY_HEADLESS=0                # 1 = headless Chromium (CI); the demo uses a visible window
BROWSER_CHANNEL=chrome          # chrome (installed Google Chrome) | chromium (npx playwright install chromium)
