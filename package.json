{
  "name": "darby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "fixtures/site"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,companion,fixtures -c cyan,magenta,yellow \"npm run dev -w @darby/server\" \"npm run dev -w @darby/companion\" \"npm run fixtures\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "test:acceptance": "tsx tests/acceptance/run.ts",
    "fixtures": "node fixtures/site/server.mjs",
    "fixtures:check": "node scripts/fixtures-check.mjs",
    "fixtures:selfcheck": "node fixtures/site/selfcheck.mjs",
    "llm:ping": "tsx scripts/llm-ping.ts",
    "guard": "bash scripts/guard-secrets.sh",
    "verify-receipt": "tsx scripts/verify-receipt.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "replay:curate": "tsx scripts/replay-curate.ts",
    "redteam": "tsx tests/acceptance/run.ts --redteam",
    "demo": "node scripts/demo.mjs",
    "desktop": "node scripts/demo.mjs --app",
    "desktop:offline": "node scripts/demo.mjs --app --offline",
    "demo:offline": "node scripts/demo.mjs --offline",
    "demo:reset": "tsx scripts/db-reset.ts --runs",
    "demo:check": "tsx scripts/demo-check.ts",
    "ui:walkthrough": "node scripts/ui-walkthrough.mjs",
    "demo:record": "tsx tests/acceptance/run.ts --live && tsx scripts/replay-curate.ts",
    "playbook:check": "tsx scripts/playbook-check.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
